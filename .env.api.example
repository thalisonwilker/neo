# Configuracoes da API FastAPI do Neo (copie para .env e preencha os valores reais)
# Nunca commite o arquivo .env com segredos.

# Banco PostgreSQL (dev e testes)
NEO_DATABASE_URL="postgresql+asyncpg://neo:neo@localhost:5432/neo"
NEO_TEST_DATABASE_URL="postgresql+asyncpg://neo:neo@localhost:5432/neo_test"

# Origens liberadas por CORS (separadas por virgula)
NEO_API_CORS_ORIGINS="http://localhost:3100"

# Validacao de sessao e leitura de e-mail via Clerk
CLERK_JWKS_URL="https://<sua-instancia>.clerk.accounts.dev/.well-known/jwks.json"
CLERK_ISSUER="https://<sua-instancia>.clerk.accounts.dev"
CLERK_AUTHORIZED_PARTIES="http://localhost:3100"
CLERK_SECRET_KEY=""
